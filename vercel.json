{
  "version": 2,
  "cleanUrls": true,
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/questions(.*)",
      "dest": "/data/questions.json"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
